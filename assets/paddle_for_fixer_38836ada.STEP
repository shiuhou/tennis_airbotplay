#15320 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#15321 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-04),#15318,
  'distance_accuracy_value','confusion accuracy');
#15322 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
